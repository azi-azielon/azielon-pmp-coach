# Application (auto-setup generates APP_SECRET)
APP_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=https://pmp.azielon.com
ACCESS_TOKEN_MINUTES=720
REQUIRE_PAID_ACCESS=true
PAYMENT_MODE=prod

# PostgreSQL (auto-setup creates the role/database and writes the real URL)
DATABASE_URL=postgresql+psycopg://azielon:CHANGE_ME@localhost:5432/azielon_pmp

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Bootstrap admin (auto-setup can create this interactively; password is not persisted)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Stripe TEST MODE only for local testing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# Password reset: test returns a local reset link; prod emails it through SMTP.
PASSWORD_RESET_MODE=test
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Live PMP class registration notifications
PROGRAM_REGISTRATION_NOTIFY_EMAIL=azi@azielon.com

# Autobooks payment link integration
AUTOBOOKS_PAYMENT_URL=
AUTOBOOKS_WEBHOOK_SECRET=


# Helcim production payments
HELCIM_API_TOKEN=
HELCIM_WEBHOOK_VERIFIER_TOKEN=
HELCIM_FEE_SAVER=true
# Create these six recurring plans in Helcim (weekly/monthly only), then paste their numeric IDs.
HELCIM_PLAN_FULL_WEEKLY_ID=
HELCIM_PLAN_FULL_MONTHLY_ID=
HELCIM_PLAN_CONCEPT_WEEKLY_ID=
HELCIM_PLAN_CONCEPT_MONTHLY_ID=
HELCIM_PLAN_DRILLS_WEEKLY_ID=
HELCIM_PLAN_DRILLS_MONTHLY_ID=
